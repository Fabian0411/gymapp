# Copia este archivo a .env y llena los valores de tu proyecto de Supabase.
# Los encuentras en: supabase.com > tu proyecto > Settings > API
#
# IMPORTANTE: aquí solo va la clave "anon/public" (está diseñada para ser
# pública). NUNCA pongas la clave "service_role" en este archivo ni en la app.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo para el script de importación de ejercicios (se ejecuta en tu PC,
# nunca se incluye en la app). Descomenta y llena solo al ejecutar el script.
# SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
